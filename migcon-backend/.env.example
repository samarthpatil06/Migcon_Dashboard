# ── Server ─────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── MQTT Broker ─────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password
MQTT_OFFLINE_TIMEOUT_MS=60000

# ── WebSocket CORS ───────────────────────────
# Comma-separated allowed origins
WS_CORS_ORIGIN=http://localhost:4200
